    ["border-input", "surface", "ui"],

    ["dark-text", "dark-bg"],
    ["dark-text", "dark-surface"],
    ["dark-text-muted", "dark-bg"],
    ["dark-text-muted", "dark-surface"],
    ["dark-on-accent", "dark-accent"],
